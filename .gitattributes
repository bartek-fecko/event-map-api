# Normalise line endings in the repository so the same checkout works on
# Windows and Linux. Shell entrypoints must stay LF or the container cannot run them.
* text=auto eol=lf

mvnw text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
