root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json}]
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf

# Windows PowerShell 5.1 reads a BOM-less script as ANSI; the BOM keeps the
# Polish city names intact.
[*.ps1]
end_of_line = crlf
charset = utf-8-bom

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
