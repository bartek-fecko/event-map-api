# Production configuration for `docker compose -f compose.prod.yaml`.
# Copy to .env and fill in real values. .env is git-ignored.

# --- public identity ---------------------------------------------------------
# Must already point at this server (A/AAAA record) before the first start.
DOMAIN=events.example.com
ACME_EMAIL=admin@example.com

# --- database ----------------------------------------------------------------
DB_NAME=eventmap
DB_USER=eventmap
DB_PASSWORD=change-me-to-a-long-random-password
DB_POOL_SIZE=10

# --- application secrets -----------------------------------------------------
# HS256 signing key: at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters
# Created on first boot; the password is not stored anywhere else.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# --- tuning / frontend -------------------------------------------------------
AUTH_RATE_LIMIT_PER_MINUTE=20
# Origin of the Next.js site, comma-separated for several.
APP_WEB_ALLOWED_ORIGINS=https://events.example.com

# --- image -------------------------------------------------------------------
# Tag to run on the server. Build and push from CI, or leave the default and
# build on the server with: docker compose -f compose.prod.yaml up -d --build
APP_IMAGE=eventmap-api:latest
