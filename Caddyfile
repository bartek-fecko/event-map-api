{
	email {$ACME_EMAIL:admin@example.com}
}

# One site block for both the API and the uploaded images.
{$DOMAIN:localhost} {
	encode zstd gzip

	# Uploaded covers live on a volume: serve the bytes without waking the JVM.
	# The app returns /media/2026/10/<uuid>.jpg, the volume holds 2026/10/<uuid>.jpg.
	handle /media/* {
		uri strip_prefix /media
		root * /srv/media
		file_server

		header {
			Cache-Control "public, max-age=31536000, immutable"
			X-Content-Type-Options "nosniff"
		}
	}

	handle {
		reverse_proxy app:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format console
	}
}
